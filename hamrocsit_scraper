#!/usr/bin/env python3
"""
Scrape all past papers (every year + model sets) of a hamrocsit.com subject
into ONE clean txt file: year, marks, sections, questions. Images ignored.

    pip install requests beautifulsoup4

    python hamrocsit_scraper.py https://hamrocsit.com/semester/sixth/ncc/
    python hamrocsit_scraper.py -s sixth -j "net centric"
    python hamrocsit_scraper.py            # interactive
"""
import argparse, re, sys, time
from pathlib import Path
from urllib.parse import urljoin, urlparse

import requests
from bs4 import BeautifulSoup

BASE = "https://hamrocsit.com"
SEMESTERS = ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eight"]  # site spells it "eight"
session = requests.Session()
session.headers["User-Agent"] = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36"
DELAY = 1.0


def clean_url(u):
    return re.sub(r"(?<!:)/{2,}", "/", u)  # site emits ".../ncc//question-bank/..."


def get(url, retries=3):
    for i in range(retries):
        try:
            r = session.get(url, timeout=25)
            if r.status_code == 200:
                time.sleep(DELAY)
                return r.text
            if r.status_code == 404:
                return None
        except requests.RequestException:
            pass
        time.sleep(2 * (i + 1))
    return None


def parse_target(text):
    m = re.search(r"semester/([a-z]+)/([A-Za-z0-9_\-]+)", text)
    if not m:
        return None
    sem = "eight" if m.group(1) == "eighth" else m.group(1)
    return (sem, m.group(2)) if sem in SEMESTERS else None


def list_subjects(sem):
    html = get(f"{BASE}/semester/{sem}/")
    if not html:
        return []
    soup = BeautifulSoup(html, "html.parser")

    def slug_of(a):
        p = urlparse(clean_url(urljoin(BASE, a["href"]))).path.strip("/").split("/")
        return p[2] if len(p) == 3 and p[0] == "semester" and p[1] == sem else None

    def title_of(a):
        node = a.parent
        while node is not None and node.name not in ("body", "html"):
            if len({slug_of(x) for x in node.find_all("a", href=True)} - {None}) > 1:
                break
            h = node.find(re.compile(r"^h[1-6]$"))
            if h and h.get_text(strip=True):
                return h.get_text(" ", strip=True)
            node = node.parent

    found = {}
    for a in soup.find_all("a", href=True):
        s = slug_of(a)
        if s and not found.get(s):
            found[s] = title_of(a)
    return [(s, n or s.upper()) for s, n in found.items()]


def list_papers(sem, slug):
    """[(label, url)] for every year / model set, in the site's order."""
    base = f"{BASE}/semester/{sem}/{slug}/question-bank"
    html = get(base)
    if not html:
        return []
    soup = BeautifulSoup(html, "html.parser")
    pat = re.compile(rf"^/semester/{sem}/{re.escape(slug)}/question-bank/[^/]+$")
    out, seen = [], set()
    for a in soup.find_all("a", href=True):
        url = clean_url(urljoin(base, a["href"]))
        if pat.match(urlparse(url).path.rstrip("/")) and url not in seen:
            seen.add(url)
            out.append((a.get_text(" ", strip=True), url))
    return out


def extract_paper(html):
    soup = BeautifulSoup(html, "html.parser")
    for t in soup(["script", "style", "noscript", "img", "svg", "picture", "video", "iframe", "button"]):
        t.decompose()
    for lst in soup.find_all(["ol", "ul"]):
        for n, li in enumerate(lst.find_all("li", recursive=False), 1):
            li.insert(0, f"{n}. " if lst.name == "ol" else "- ")
    lines = [re.sub(r"\s+", " ", l).strip() for l in soup.get_text("\n").splitlines()]
    lines = [l for l in lines if l]
    merged = []
    for l in lines:                                           # "1." + "Polymorphism" -> "1. Polymorphism"
        if merged and re.fullmatch(r"(\d+\.|-)", merged[-1]):
            merged[-1] += " " + l
        else:
            merged.append(l)
    lines = merged

    base = max((i for i, l in enumerate(lines) if l.lower() == "exam year"), default=0)
    start = next((i for i in range(base, len(lines)) if lines[i].lower().startswith("tribhuvan university")), None)
    if start is None:
        return ""
    end = next((i for i in range(start, len(lines))
                if re.search(r"question bank solution|^solution( video)?$|share this link", lines[i], re.I)), len(lines))
    body = lines[start:end]

    sec = next((i for i, l in enumerate(body) if re.match(r"(?i)^(section|group)\b", l)), None)
    if sec is None:
        return "\n".join(body)
    marks = [l for l in body[:sec] if re.match(r"(?i)^(full|pass) marks", l)]

    out, i, rest = list(marks), 0, body[sec:]
    while i < len(rest):
        l = rest[i]
        if re.fullmatch(r"\d{1,2}", l):                       # bare question number
            nxt = rest[i + 1] if i + 1 < len(rest) else ""
            if nxt and not re.fullmatch(r"\d{1,2}", nxt):
                out += ["", f"Q{l}. {nxt}"]
                i += 2
            else:                                             # image-only question: drop
                i += 1
        else:
            out.append(("\n" + l) if re.match(r"(?i)^(section|group)\b", l) else l)
            i += 1
    return "\n".join(out).strip()


def scrape_subject(sem, slug, name, outdir):
    print(f"\n== {name} ({sem} semester)")
    papers = list_papers(sem, slug)
    if not papers:
        print("  no question bank found")
        return
    chunks = []
    for label, url in papers:
        text = extract_paper(get(url) or "")
        if text:
            print(f"  ok   {label}")
            chunks.append(f"===== {label} =====\n{text}\n")
        else:
            print(f"  skip {label} (nothing extracted)")
    outdir.mkdir(parents=True, exist_ok=True)
    path = outdir / f"{sem}_{slug}_questions.txt"
    path.write_text(f"{name}\n\n" + "\n\n".join(chunks), encoding="utf-8")
    print(f"  saved -> {path}")


def interactive():
    print("Semester (or paste a subject link):")
    for i, s in enumerate(SEMESTERS, 1):
        print(f"  {i}. {s.capitalize()}")
    ans = input("> ").strip()
    if "hamrocsit" in ans:
        t = parse_target(ans)
        return [(t[0], t[1], t[1].upper())] if t else []
    if not ans.isdigit() or not 1 <= int(ans) <= len(SEMESTERS):
        return []
    sem = SEMESTERS[int(ans) - 1]
    subjects = list_subjects(sem)
    print("\nSubjects (e.g. 1,3 or 'all'):")
    for i, (s, n) in enumerate(subjects, 1):
        print(f"  {i}. {n}  [{s}]")
    ans = input("> ").strip()
    idx = range(len(subjects)) if ans.lower() == "all" else [int(x) - 1 for x in re.findall(r"\d+", ans)]
    return [(sem, subjects[i][0], subjects[i][1]) for i in idx if 0 <= i < len(subjects)]


def main():
    global DELAY
    ap = argparse.ArgumentParser()
    ap.add_argument("urls", nargs="*", help="subject link(s)")
    ap.add_argument("-s", "--semester", choices=SEMESTERS + ["eighth"])
    ap.add_argument("-j", "--subject", help="subject name or slug (partial ok), with -s")
    ap.add_argument("--all", action="store_true", help="with -s: every subject in the semester")
    ap.add_argument("-o", "--out", default=".", help="output folder (default: current)")
    ap.add_argument("--delay", type=float, default=1.0)
    a = ap.parse_args()
    DELAY = a.delay
    jobs = []
    for u in a.urls:
        t = parse_target(u)
        if t:
            jobs.append((t[0], t[1], t[1].upper()))
    if a.semester:
        sem = "eight" if a.semester == "eighth" else a.semester
        subs = list_subjects(sem)
        if a.all:
            jobs += [(sem, s, n) for s, n in subs]
        elif a.subject:
            q = a.subject.lower()
            hits = [(s, n) for s, n in subs if q in s.lower() or q in n.lower()]
            if not hits:
                sys.exit("No match. Available: " + ", ".join(n for _, n in subs))
            jobs += [(sem, s, n) for s, n in hits]
        else:
            sys.exit("With -s also give -j <subject> or --all")
    jobs = jobs or interactive()
    if not jobs:
        sys.exit("Nothing to do.")
    for sem, slug, name in jobs:
        scrape_subject(sem, slug, name, Path(a.out))


if __name__ == "__main__":
    main()